{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profiles storing phone number, device ID, and premium status",
      "properties": {
        "phoneNumber": { "type": "string" },
        "deviceId": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["phoneNumber", "deviceId", "isPremium"]
    },
    "paymentRequests": {
      "title": "Payment Request",
      "description": "Pending payment requests uploaded by students with transaction screenshot for admin review",
      "properties": {
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "transactionId": { "type": "string" },
        "screenshotUrl": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "processedAt": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["userId", "studentName", "mobileNumber", "transactionId", "status", "createdAt"]
    }
  },
  "firestore": {
    "/paymentRequests/{requestId}": {
      "schema": "paymentRequests",
      "description": "Collection storing payment verification requests from users"
    }
  }
}
